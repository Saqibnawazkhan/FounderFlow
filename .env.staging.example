# =============================================================================
# FounderFlow — STAGING env (Tier 2 env separation)
#
# Copy to `.env.staging` (gitignored) and fill in with a SECOND Supabase
# project's credentials — never the production one. CI targets this env.
#
# How to create the staging Supabase project:
#   1. Sign in to https://supabase.com/dashboard
#   2. "New project" → same region as prod, free tier is fine
#   3. Project name suggestion: `founderflow-staging`
#   4. Project Settings → Database → Connection string:
#        DATABASE_URL  = "Transaction pooler" (port 6543)
#        DIRECT_URL    = "Direct connection"  (port 5432)
#   5. Rotate AUTH_SECRET (`openssl rand -base64 32`) — staging must NOT
#      reuse the production secret; a shared secret means a stolen staging
#      JWT would sail into prod.
#   6. Add these values to Vercel's staging environment (Project → Settings
#      → Environment Variables, scope = "Preview")
#
# CI should run migrations against staging on every merge to main:
#   `npx prisma migrate deploy` (NOT `migrate dev` — deploy is prod-safe,
#   never generates new migrations, only applies existing ones).
# =============================================================================

# =============================================================================
# REQUIRED, and it is not decoration: scripts/db-staging.mjs REFUSES to run
# without it.
#
# `npm run db:migrate:staging` was a bare `prisma migrate deploy` until
# 2026-09-26. The Prisma CLI resolves DATABASE_URL from the root `.env` — which
# held the PRODUCTION credentials — so that command applied migrations straight
# to production, from a name that says staging.
#
# The guard cannot work by inspecting the URL: staging and production are both
# `*.pooler.supabase.com` on the same ports, so nothing about the string tells
# them apart. A deliberate declaration is the only thing that can, and it
# cannot be satisfied by accident in a production env file.
# =============================================================================
FF_ENV="staging"

NEXT_PUBLIC_APP_URL="https://founderflow-staging.vercel.app"

# Fill from the "founderflow-staging" Supabase project — NOT prod.
# Leave no `<placeholder>` behind: the guard rejects any value still containing
# angle brackets, because copying this file and filling in only one of the two
# URLs is the likeliest mistake. It also rejects any host the root `.env` names,
# so pasting the production string here fails even with FF_ENV set.
DATABASE_URL="postgresql://postgres.<staging-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# USE THE "SESSION POOLER", NOT "DIRECT CONNECTION". Both are port 5432 and
# both work from a laptop, but Supabase's direct connection
# (db.<ref>.supabase.co) is IPv6-ONLY unless the project buys the IPv4
# add-on — and GitHub Actions runners are IPv4-only. Get that wrong and the
# staging-migrate CI job cannot connect at all, with an error that looks like
# a credential problem. Production already uses the session-pooler shape,
# which is why .github/workflows/backup.yml rewrites its URL that way.
# Session pooler = same pooler host as DATABASE_URL, user postgres.<ref>,
# port 5432, and NO pgbouncer params (migrations need a real session).
DIRECT_URL="postgresql://postgres.<staging-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# openssl rand -base64 32 — must differ from prod
AUTH_SECRET=""
AUTH_URL="https://founderflow-staging.vercel.app"

# Same Gmail infra as prod is OK — recipients see the same "FounderFlow"
# sender. Or provision a distinct app-password so staging bounces don't
# eat prod's Gmail quota.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM=""

CRON_SECRET=""
RATE_LIMIT_DISABLED="false"

# Distinct Sentry project so staging noise doesn't pollute prod's issue list.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Soft-delete purge cron (/api/cron/purge-soft-deleted, 03:15 UTC) ---
# MASTER SWITCH for the destructive nightly hard-delete. Unset or anything
# other than "true" = DRY RUN: the cron counts what *would* be purged and
# deletes nothing. Set to "true" only when you intend overdue tombstoned
# workspaces to be erased for real. See CLAUDE.md "Tier 3 recovery layer".
PURGE_ENABLED="false"
