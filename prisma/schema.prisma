// FounderFlow schema. Postgres everywhere: a docker-compose Postgres 16 on
// 127.0.0.1:5433 for local dev (see CLAUDE.md), Supabase for staging + prod.
// The model shape mirrors the TypeScript interfaces in lib/types.ts.
//
// Conventions:
// - role/type/status are stored as Strings (not Prisma enums) with the allowed
//   values documented inline; the zod schemas in lib/schemas/ are the source
//   of truth at the application boundary.
// - Money (Transaction.amount, RecurringRule.amount, Budget.monthlyLimit) is
//   Decimal(12,2), not Float — see the P0-4 migration.
// - The NINE soft-delete tables (User/Company/Project/Task/Budget/Transaction
//   /Message/Comment/TimeEntry) carry a nullable deletedAt sentinel; scoped
//   reads filter deletedAt: null. Message joined the set with the chat rollout
//   — a deleted chat message is tombstoned, never erased, so a thread can't
//   silently rewrite its own history. Comment and TimeEntry joined on
//   2026-09-29 (data-integrity-001): both were hard deletes while the Tier 3
//   section of CLAUDE.md counted them as recoverable for 90 days.
//   This count is not decoration — tests/lib/db/purge-invariants.test.ts
//   DERIVES the list from the model blocks below and checks the nightly purge,
//   the workspace tombstone sweep and the existence of a writer against it, so
//   a tenth table is covered on the day its column lands.

generator client {
  provider      = "prisma-client-js"
  // Generate engines for both the local dev OS (native) AND Vercel's
  // serverless runtime (Linux + OpenSSL 3). Without the rhel target, the
  // deployed function throws PrismaClientInitializationError "could not
  // locate the Query Engine for runtime rhel-openssl-3.0.x".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  // No `output` override — keep the default node_modules/.prisma/client
  // location so Next.js's serverless file tracing auto-includes the .so.node
  // engine binary in the deployment bundle.
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl is used by `prisma migrate` and introspection; it must bypass
  // any connection pooler. On Supabase: DATABASE_URL is the transaction
  // pooler (port 6543), DIRECT_URL is the direct connection (port 5432).
  // For local dev a single direct URL in both vars works fine.
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  // Parser-addressable name: the token after the `@` in a comment or chat
  // mention (`@ali`). Deliberately NOT `name` — a name is how PEOPLE address
  // you and may be written in any script; a handle is how the MENTION PARSER
  // addresses you and has to survive an ASCII token grammar. The gap between
  // the two was a live bug (FaultsAudit T16): slugifyName() in
  // lib/comments/mentions.ts ends in `.replace(/[^a-z0-9-]/g, "")`, so a
  // teammate whose name carries no ASCII letters — ordinary in the Urdu locale
  // this product ships — slugified to the EMPTY STRING and was unmentionable
  // inside their own workspace, with nothing in the UI saying why.
  //
  // REJECTED ALTERNATIVE — widening the token regex to `\p{L}`. An `@`
  // followed by Urdu prose has no ASCII word boundary to stop at, so the parser
  // cannot tell where the mention ends and the sentence resumes; `@ali` becomes
  // ambiguous with any Urdu text after an `@`. Giving everyone a typable ASCII
  // address leaves the grammar alone instead of making it guess. Do not
  // "simplify" this column away by widening the regex.
  //
  // PER-COMPANY, not global. Mentions only ever resolve inside a workspace, so
  // two companies may each hold an `@ali` for the same reason they may each
  // hold a #general (see Channel.slug). A global unique would make the second
  // `ali` to sign up anywhere in the product wear a suffix forever.
  //
  // NULLABLE, and safe to be: Postgres unique indexes are NULLS DISTINCT by
  // default, and a multi-column key counts as a duplicate only when EVERY
  // column matches — a NULL never equals a NULL, so a row with a NULL handle
  // cannot conflict with anything and unlimited handle-less users coexist in
  // one company under @@unique([companyId, handle]) below. That is what lets
  // the column ship without a NOT NULL backfill that must provably succeed for
  // every historical row, including rows whose local-part sanitises to nothing.
  // 20260925140000_add_user_handle backfills every row that exists today.
  handle          String?
  passwordHash    String // bcrypt hash, never the raw password
  role            String // "admin" | "cofounder" | "member"
  avatar          String?
  companyId       String
  createdAt       DateTime  @default(now())
  // Updated by the Auth.js signIn callback. Surfaces on /settings as
  // "Last sign-in" so the user can spot rogue logins. Nullable for
  // legacy rows that predate the column.
  lastSignInAt    DateTime?
  // Set the moment the user clicks their email-verification link. NULL =
  // unverified (the default for a fresh signup, and for legacy rows that
  // predate the column). Drives the "verify your email" banner. Soft gate
  // for now — nothing is blocked while null; the EMAIL_VERIFICATION_REQUIRED
  // env flag is reserved for a future hard gate.
  emailVerifiedAt DateTime?
  // Cross-device UI preferences (S6). Synced from the settings appearance +
  // language controls so a user's theme/locale follow them to a new device
  // instead of living only in that browser's localStorage.
  theme           String    @default("dark") // "light" | "dark"
  locale          String    @default("en") // "en" | "ur"
  // Session-invalidation counter. Baked into the JWT at sign-in; the auth
  // jwt callback re-checks it against this column on every request and kills
  // the session if they diverge. Bumping it (password reset, "log out
  // everywhere") force-signs-out every existing token instead of waiting for
  // the cookie to expire. Complements the deletedAt check below.
  sessionVersion  Int       @default(0)
  // DELIBERATELY ABSENT: a durable per-account login-failure counter.
  // Proposed 2026-09-28 for sec-011 and removed 2026-09-29 after the wiring
  // was attempted. A brute-force gate has to run BEFORE bcrypt or it limits
  // no guesses, and a pre-bcrypt account-keyed gate cannot distinguish a
  // guess from the owner's correct password — so the failures an attacker
  // sends for free refuse the real owner too. The in-memory equivalent
  // (`limiters.credentialsEmail`, 10 failures/15min) is survivable only
  // because it evaporates on a cold start; a column would make that lockout
  // reliable, fleet-wide and deploy-proof, with no admin unlock in this app.
  // It buys one order of magnitude on a number that changes no outcome.
  // The answer to sec-011 is a shared store keyed on the CLIENT ADDRESS
  // (Upstash / Vercel KV) — that bucket is purely protective, and it has no
  // row to hang off, which is exactly why the row route looked cheap.
  // Tier 3 soft-delete sentinel. NULL = live row. Any timestamp = soft
  // deleted; the row survives until the nightly purge cron hard-deletes
  // it after 90 days. Auth + queries filter `deletedAt: null` so a
  // soft-deleted user can't sign in and their data isn't rendered, but
  // ops can restore with `UPDATE "User" SET "deletedAt" = NULL`.
  deletedAt       DateTime?

  company            Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownedCompany       Company?                 @relation("CompanyOwner")
  transactions       Transaction[]
  assignedTasks      Task[]                   @relation("TaskAssignee")
  createdTasks       Task[]                   @relation("TaskCreator")
  activities         Activity[]
  notifications      Notification[]
  recurringRules     RecurringRule[]
  budgets            Budget[]
  comments           Comment[]                @relation("CommentAuthor")
  timeEntries        TimeEntry[]              @relation("TimeEntryUser")
  editedEntries      TimeEntry[]              @relation("TimeEntryEditor")
  // Projects this user supervises (1:N — one user can supervise many).
  // SetNull on delete so the project survives the supervisor leaving;
  // the actions layer re-assigns via changeSupervisorAction immediately
  // after, but the DB never blocks the user delete.
  supervisedProjects Project[]                @relation("ProjectSupervisor")
  createdProjects    Project[]                @relation("ProjectCreator")
  pushSubscriptions  PushSubscription[]
  notifyPrefs        NotificationPreference[]
  // Chat. Memberships are the rail; createdChannels/messages/reactions exist
  // so the whole-workspace purge can walk this user's chat rows explicitly.
  createdChannels    Channel[]                @relation("ChannelCreator")
  channelMemberships ChannelMember[]
  messages           Message[]                @relation("MessageAuthor")
  messageReactions   MessageReaction[]

  // One handle per workspace. Also the lookup index the mention resolver reads
  // through (companyId + handle), so no separate @@index is needed.
  @@unique([companyId, handle])
  @@index([companyId])
  @@index([email])
  @@index([deletedAt])
}

// Web Push subscriptions — one row per device/browser a user opts in from.
// `endpoint` is the push-service URL (unique); p256dh + auth are the client
// keys the web-push protocol needs to encrypt the payload. Pruned when the
// push service reports the subscription gone (404/410).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Per-user, per-event delivery preferences. Absent row = the defaults in
// lib/notify/preferences.ts, so signing up writes nothing and a new event can
// ship without a backfill.
//
// Enforced in ONE place — lib/notify/fan-out.ts. That is the whole reason the
// fan-out was centralised first (FaultsAudit S9: "a real preferences matrix
// has to be *enforced*, not decorative"); a structural test fails the build if
// a notification is ever written around it.
model NotificationPreference {
  id     String @id @default(cuid())
  userId String
  // A NotifyEvent. String, not a Prisma enum — lib/notify/fan-out.ts owns the
  // union, matching how the rest of the schema defers to zod at the boundary.
  event  String

  // The three delivery channels, independently switchable.
  inApp Boolean @default(true)
  email Boolean @default(true)
  push  Boolean @default(true)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per person per event; the fan-out upserts on this.
  @@unique([userId, event])
  // The fan-out reads every preference for a set of recipients at once.
  @@index([userId])
}

model Company {
  id        String    @id @default(cuid())
  name      String
  industry  String
  currency  String    @default("PKR")
  // Nullable to break the circular FK with User (User.companyId required,
  // and Company would also require ownerId). The signup server action
  // creates the company first, then the owner, then updates ownerId.
  ownerId   String?   @unique
  createdAt DateTime  @default(now())
  // Tier 3 soft-delete sentinel — see User.deletedAt for semantics.
  deletedAt DateTime?

  // --- Subscription billing (LemonSqueezy; see lib/lemonsqueezy, lib/billing) ---
  // Provider-neutral names so the layer can be swapped. Additive + nullable so
  // no existing workspace is touched — everyone starts on "free". The
  // LemonSqueezy webhook is the source of truth: it fills these on subscription
  // events. `plan` gates paid features.
  plan                  String    @default("free")
  billingCustomerId     String?
  billingSubscriptionId String?
  subscriptionStatus    String?
  currentPeriodEnd      DateTime?

  owner          User?           @relation("CompanyOwner", fields: [ownerId], references: [id])
  billingEvents  BillingEvent[]
  users          User[]
  transactions   Transaction[]
  tasks          Task[]
  activities     Activity[]
  notifications  Notification[]
  inviteTokens   InviteToken[]
  recurringRules RecurringRule[]
  budgets        Budget[]
  comments       Comment[]
  timeEntries    TimeEntry[]
  projects       Project[]
  channels       Channel[]
  messages       Message[]

  @@index([deletedAt])
}

// ─── Billing ledger ──────────────────────────────────────────────────────────
//
// One row per webhook DELIVERY we acted on (bill-002 + bill-009, 2026-09-29).
// Two different holes, closed by the same table, which is why it is one table
// and not a log plus a dedupe cache:
//
//   bill-009 — nothing anywhere recorded that a billing event had ever arrived.
//     After a dispute ("I cancelled in March, you charged me in April") the only
//     record was LemonSqueezy's own dashboard: the counterparty's copy, with the
//     counterparty's retention. Our side could show the CURRENT Company row and
//     nothing about how it got there. Sentry breadcrumbs are not that record —
//     they cover the deliveries we REFUSED (see reportSkippedBillingWrite) and
//     expire on Sentry's retention.
//   bill-002 — replay protection was INFERRED from state already on the Company
//     row (is the stored status dead? has the stored period passed?) plus a
//     7-day age ceiling on grants. A LemonSqueezy HMAC never expires, so a
//     delivery captured once was re-playable for as long as its own dates stayed
//     current. Nothing could tell a first delivery from its tenth replay,
//     because nothing remembered the first.
//
// HOW IT BECOMES AN IDEMPOTENCY KEY RATHER THAN A LOG. The webhook inserts its
// row INSIDE the same `$transaction` as the Company update and treats a Prisma
// P2002 on `eventId` as "already applied — skip". Same transaction is the whole
// mechanism: a rollback takes the ledger row with it, so a delivery is recorded
// as applied if and only if its write committed, and a replay loses the race on
// the unique index instead of on a timestamp comparison.
model BillingEvent {
  id String @id @default(cuid())

  // THE IDEMPOTENCY KEY. The provider's own identifier for this delivery.
  //
  // NOT NULL, and that is load-bearing rather than tidy: Postgres unique indexes
  // are NULLS DISTINCT, so a nullable unique column deduplicates NOTHING and a
  // replay with no id would insert happily, for ever, while the schema looked
  // like it had replay protection. (Same property, used deliberately in the
  // opposite direction, on User.handle.)
  //
  // So the writer must always have a value. LemonSqueezy's payload carries
  // `meta.webhook_id` on current deliveries but this integration cannot prove it
  // for every event it is subscribed to, and a missing field must not become a
  // missing constraint. Where the provider gives no id, derive one DETERMIN-
  // ISTICALLY from the signed bytes — `sha256:<hex of the raw body>`, which the
  // route already has in hand for the HMAC. Never a cuid, a uuid or a
  // timestamp: a freshly-minted value collides with nothing, so the constraint
  // silently stops being a dedupe key and becomes a row counter.
  eventId String @unique

  // `meta.event_name` — subscription_created, subscription_payment_failed, …
  // Stored verbatim, including names this deployment does not handle, so the
  // ledger answers "what arrived" and not merely "what we understood".
  eventName String

  // Provider-assigned ids, both nullable because both genuinely go missing: an
  // invoice payload carries `attributes.subscription_id` rather than `data.id`,
  // and a delivery that fails scope checks may carry neither. NOT the buyer's
  // `custom_data` claim — that is untrusted input (bill-001) and has no business
  // in the audit trail as if it were fact.
  subscriptionId String?
  customerId     String?

  // The workspace this delivery resolved to, or NULL for one that resolved to
  // none — forged, out-of-scope, or for a subscription this deployment has never
  // seen. NULL is the most valuable row in the table and must stay insertable:
  // "money arrived and we could not place it" is precisely the state bill-008
  // found being answered with a cheerful 200 and no record at all. A required FK
  // would refuse exactly that row.
  companyId String?

  // WHAT WE DID ABOUT IT, in one token: "applied" | "skipped" | "refused".
  // NOT NULL with no default, on purpose — the writer has to state it. A default
  // would let a future insert record a refusal as an application by omission,
  // and a ledger that cannot distinguish the two answers none of the questions
  // it was built for. Pair it with `reason` for the detail.
  outcome String
  // The machine-readable reason QUALIFYING the outcome — the same verdict strings
  // the Sentry breadcrumbs already use ("stale-grant", "unresolvable", "replay",
  // "wrong-store"). Usually NULL on an `applied` row, and NULL always means
  // "nothing further to say", never "the write was refused" — read `outcome` for
  // that.
  //
  // AND IT IS NOT ONLY FOR NON-APPLIED OUTCOMES, which is what this comment used
  // to say. An application that had to DROP a field it could not read carries
  // `outcome: "applied"` WITH `reason: "period-end-unreadable"` (bill-010, see
  // app/api/webhooks/lemonsqueezy/route.ts): the delivery really did apply, and
  // the customer's stored paid-through date is now silently stale. "Applied with
  // no reason" and "applied with one column quietly not updated" must not be the
  // same row, because the second is what a billing dispute turns on.
  reason  String?

  // THE RAW SIGNED BODY, verbatim, as the bytes arrived.
  //
  // KEPT, after weighing it. A ledger row without the payload cannot settle the
  // dispute it exists for: "subscription_updated arrived at 03:12" says nothing
  // about what it CLAIMED, which is the entire question. Verbatim rather than a
  // picked subset because these exact bytes are the only thing that can be
  // re-verified against the stored HMAC later — a re-serialised copy changes key
  // order and whitespace and verifies as a forgery.
  //
  // WHAT IS ACTUALLY IN IT, because "raw payload" hides the question. A
  // LemonSqueezy subscription payload carries user_email, user_name, card_brand
  // and card_last_four. That is identifying customer data under the same
  // retention promise as the rest of the workspace — it is NOT cardholder data:
  // no PAN, no CVV, and no token that could charge anybody. So this column does
  // not pull the schema into PCI scope, and it does have to be erasable with the
  // workspace, which is what the Cascade below and the explicit
  // `tx.billingEvent.deleteMany` in the purge cron are for.
  //
  // NULLABLE so it can be redacted independently: a retention job can null the
  // payload and keep the skeleton (what arrived, when, in what order, what we
  // did), which a NOT NULL column would forbid. NULL means "not retained", never
  // "nothing arrived".
  payload String?

  receivedAt DateTime @default(now())

  // Nullable FK, Cascade. Cascade so an erased workspace takes its billing
  // payloads with it instead of leaving card-adjacent detail behind after the
  // Tier 3 window; the purge cron also names this table explicitly, because this
  // schema's own doctrine is that relying on cascade ordering is the bug (see
  // purgeCompany's header). An unplaced row (companyId NULL) has no workspace to
  // be erased with and needs a time-based sweep of its own — noted as an open
  // follow-up rather than pretended away.
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // "Every delivery for this workspace, newest first" — the support query — and
  // the index Postgres needs to resolve the Cascade above without a sequential
  // scan (the omission that was perf-005 on Notification.projectId).
  @@index([companyId, receivedAt])
  // "Every delivery for this subscription" — the bill-012 question: one payer,
  // two workspaces, which cancellation belonged to which.
  @@index([subscriptionId])
}

model Transaction {
  id          String    @id @default(cuid())
  companyId   String
  type        String // "expense" | "investment"
  // Decimal(12, 2) — up to 10 billion with cent precision. Previously
  // `Float`, which drifts on SUM() past a few million rows and can't
  // represent 0.10 exactly. See FaultsAudit.md P0-4.
  amount      Decimal   @db.Decimal(12, 2)
  category    String
  description String
  date        DateTime
  addedBy     String
  addedByName String // denormalized for fast read paths
  createdAt   DateTime  @default(now())
  // Tier 3 soft-delete sentinel — see User.deletedAt for semantics.
  deletedAt   DateTime?

  // Set when this row was materialized from a RecurringRule. Lets the UI
  // show a 🔁 badge and lets the user audit which rule generated what.
  // Null for manually-created transactions. SetNull on rule delete so the
  // history survives if the user removes the rule.
  ruleId String?
  rule   RecurringRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  // Optional project tag. When set, this transaction counts against the
  // project's category budget(s); when null, it counts against company-wide
  // budgets only. Existing rows are null after migration — pre-projects
  // transactions remain company-global.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [addedBy], references: [id], onDelete: Cascade)
  comments Comment[]

  // THE IDEMPOTENCY KEY FOR RECURRING SPEND (cron-003, added 2026-09-28).
  // Materialization used to be a read-then-write with nothing behind it: two
  // overlapping runs of /api/cron/materialize-recurring both read a stale
  // `lastMaterializedAt` and both inserted, so a customer's books showed a rent
  // charge twice — and every derived figure the product sells (burn, runway,
  // budget alerts, reports, CSV export) was wrong with nothing flagging it.
  // The route now claims each rule with a conditional UPDATE, and this is the
  // second line of defence: one rule can hold at most one transaction per
  // occurrence date, enforced by Postgres rather than by timing.
  //
  // Two things make it safe on the live table. (a) `date` is now the UTC
  // midnight of the occurrence, not the instant the job ran, so the pair is
  // stable across reruns — see MaterializedTransaction.date. (b) A composite
  // unique treats rows as distinct when any column is NULL, so every
  // hand-entered transaction (ruleId IS NULL) is outside the constraint.
  @@unique([ruleId, date])
  @@index([companyId, date])
  @@index([companyId, type])
  @@index([addedBy])
  @@index([ruleId])
  @@index([projectId, date])
  @@index([deletedAt])
}

// Repeating-transaction template. A daily cron at /api/cron/materialize-recurring
// scans active rules and creates a Transaction whenever today matches the
// rule's frequency window AND we haven't already materialized today.
//
// frequency = "monthly" → uses dayOfMonth (1-31; clamped to month length
//                          so dayOfMonth=31 fires on Feb 28/29)
// frequency = "weekly"  → uses dayOfWeek (0=Sun … 6=Sat)
//
// We keep both day fields nullable to avoid a column-per-frequency table —
// the materializer + zod schema enforce that the right one is set.
model RecurringRule {
  id                 String    @id @default(cuid())
  companyId          String
  type               String // "expense" | "investment"
  // See Transaction.amount comment — same precision, same reason.
  amount             Decimal   @db.Decimal(12, 2)
  category           String
  description        String
  addedBy            String // userId who created the rule
  addedByName        String // denormalized (same pattern as Transaction)
  frequency          String // "monthly" | "weekly"
  dayOfMonth         Int? // 1-31 (when frequency=monthly)
  dayOfWeek          Int? // 0-6  (when frequency=weekly)
  active             Boolean   @default(true)
  // First-fire date — also the date used for the immediate "seed" transaction
  // we create at rule-creation time so the user gets instant feedback.
  startDate          DateTime
  // Set on every successful materialization so the cron can detect "already
  // ran today" and stay idempotent if it fires twice in a 24h window.
  lastMaterializedAt DateTime?
  createdAt          DateTime  @default(now())

  // Optional project attribution, carried onto every materialized Transaction
  // (money-005, added 2026-09-28). Without it recurring spend — rent, salaries,
  // subscriptions, the outgoings a founder most wants capped — could not trip a
  // budget alert even once: every Budget belongs to a project, and
  // `checkBudgetThresholdAfterExpense` (lib/budgets/check.ts) returns early when
  // the transaction has no projectId. So /budgets showed red while the alerting
  // stayed silent. SetNull, matching Transaction.projectId: deleting a project
  // must not delete the rule that funds it.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [addedBy], references: [id], onDelete: Cascade)
  transactions Transaction[] // materialized children — survives rule deletion

  @@index([companyId, active])
  @@index([active, frequency])
  // The SetNull above has to find these rows when a project is hard-deleted by
  // the nightly purge, and /projects/[id] reads a project's rules. Same reason
  // as Notification_projectId_idx (perf-005).
  @@index([projectId])
}

model Task {
  id             String    @id @default(cuid())
  companyId      String
  // Required after the add_projects migration backfills every legacy row
  // to a "General" project per company. onDelete: Restrict so a project
  // can't be deleted while it still has tasks — admins must archive or
  // reparent tasks first.
  projectId      String
  title          String
  description    String
  status         String // "pending" | "in_progress" | "completed"
  priority       String // "low" | "medium" | "high" | "urgent"
  assignedTo     String
  assignedToName String
  assignedBy     String
  assignedByName String
  deadline       DateTime
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  // Manual sort key for kanban drag-reorder within a column. Smaller = higher
  // in the column. Backfilled to `-epoch(createdAt)` so the initial order
  // matches the old newest-first default; new tasks get `-Date.now()` to land
  // at the top. Reorder sets a midpoint between neighbors (Float so we rarely
  // need to renumber). See lib/actions/tasks.ts reorderTaskAction.
  order          Float     @default(0)
  // Tier 3 soft-delete sentinel — see User.deletedAt for semantics.
  deletedAt      DateTime?

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignee    User        @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: Cascade)
  creator     User        @relation("TaskCreator", fields: [assignedBy], references: [id], onDelete: Cascade)
  comments    Comment[]
  timeEntries TimeEntry[]

  @@index([companyId, status])
  @@index([projectId, status])
  @@index([assignedTo])
  @@index([deletedAt])
  // Support the kanban/list sort (order asc) without an in-memory sort of the
  // whole company/project task set on every /tasks load.
  @@index([companyId, order])
  @@index([projectId, order])
}

model Activity {
  id        String   @id @default(cuid())
  companyId String
  // Optional project tag. Project-scoped events (project_created,
  // task_created, supervisor changed, etc.) carry the projectId so the
  // per-project Activity tab can filter without scanning every event.
  // SetNull on project delete so historical events outlive the project.
  projectId String?
  type      String // ActivityType union from lib/types.ts
  message   String
  userId    String
  userName  String
  metadata  String? // JSON-encoded ActivityMetadata discriminated union
  createdAt DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([projectId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  // Optional project scope — set for project-scoped notifications
  // (supervisor assigned, project task created, project budget alerted).
  // Drives the read-side strip-finance-for-members filter so we can keep
  // serving members project pings without leaking non-project budget alerts.
  projectId String?
  title     String
  message   String
  type      String // "info" | "success" | "warning" | "danger"
  // Topic bucket for the notifications-page filter (X4): "task" | "finance"
  // | "team" | "system". Set at every creation site; defaults to "system"
  // so an un-tagged write (or a legacy row) still lands somewhere valid.
  category  String   @default("system")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, createdAt])
  // Company-scoped reads (workspace export, admin views) were doing a full
  // table scan — Notification was the one company-scoped table with no
  // companyId-leading index. Matches the pattern on Transaction/Comment/etc.
  @@index([companyId, createdAt])
  // perf-005. `project` above is onDelete: SetNull, and Postgres resolves a
  // referential action by querying the referencing table — with no index that
  // is a sequential scan of Notification, the fastest-growing table here, ONCE
  // PER PURGED PROJECT. The nightly purge deletes overdue projects inside a
  // route capped at maxDuration = 60, so ten projects against a 500k-row
  // Notification table timed the stage out and it reported a failure for ever
  // while tombstones piled up past their retention promise. Every sibling
  // project-referencing table was already indexed
  // (Transaction_projectId_date_idx, TimeEntry_projectId_clockInAt_idx,
  // Activity_projectId_createdAt_idx) — this was an omission, not a policy.
  @@index([projectId])
}

// Closes audit flaw #7: admins no longer set temp passwords directly. The
// invite action stores a row here + emails a one-time link; the recipient
// sets their own password on accept. Rows are single-use (usedAt set on
// accept) and expire after 7 days (expiresAt checked at accept-time).
//
// We deliberately do NOT create the User row at invite-time — that would
// leave a placeholder account with no password if the invite is never
// accepted, and it'd block the same email from re-inviting later.
model InviteToken {
  id        String    @id @default(cuid())
  token     String    @unique // random ~32-char, used in the email URL
  email     String // lowercased, what the invitee will sign in with
  name      String
  role      String // "cofounder" | "member"  (never "admin" — separate flow)
  companyId String
  invitedBy String // userId of the admin who sent the invite
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
  @@index([companyId])
}

// Per-category monthly spending caps. Threshold check happens inside
// addTransactionAction: after the txn commits, sum month-to-date expenses
// for that category and fan out a notification to all company members if
// we crossed 80% (warning) or 100% (alert). Both thresholds fire once per
// month per budget — `lastWarnedMonth` and `lastAlertedMonth` track which
// "YYYY-MM" string the budget last fired for so we don't spam.
model Budget {
  id               String    @id @default(cuid())
  companyId        String
  // Required after add_projects backfills every legacy row to a "General"
  // project per company. onDelete: Restrict so a project can't be deleted
  // while it still has budgets attached (admin must archive or reparent).
  projectId        String
  category         String // single expense category, e.g. "Office Rent"
  // Decimal(12, 2) matches Transaction.amount so any (limit − sum) math
  // stays on the same numeric domain. See FaultsAudit.md P0-4.
  monthlyLimit     Decimal   @db.Decimal(12, 2)
  createdBy        String
  createdByName    String
  active           Boolean   @default(true)
  // "2026-05" sentinels — set when the corresponding threshold fired this
  // calendar month; cleared/rotated on first hit of the next month.
  lastWarnedMonth  String? // 80%+ fired in this YYYY-MM
  lastAlertedMonth String? // 100%+ fired in this YYYY-MM
  createdAt        DateTime  @default(now())
  // Tier 3 soft-delete sentinel — see User.deletedAt for semantics.
  deletedAt        DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  // One active budget per category per project. Emulated in the action layer,
  // in BOTH directions since finance-planning-011: `createBudgetAction` refuses
  // a second active cap, and `updateBudgetAction` refuses a resume that would
  // produce one. Paused and tombstoned rows are excluded from both probes.
  //
  // This used to say a SQL unique "can't be conditional on `active` in
  // Postgres", which blames the wrong layer: Postgres expresses it exactly, as
  // a PARTIAL unique index (`... ON "Budget"("projectId", category) WHERE
  // active AND "deletedAt" IS NULL`) — it is Prisma's schema language that
  // cannot declare one, so it would take a hand-written migration. Worth doing:
  // it is the only thing that would catch rows that predate the resume guard.
  @@index([companyId, active])
  @@index([companyId, category])
  @@index([projectId, active])
  @@index([projectId, category])
  @@index([deletedAt])
}

// Threaded discussion attached to either a Task or a Transaction (XOR —
// exactly one of taskId / transactionId is non-null; enforced in the zod
// schema and the createCommentAction). One model instead of two parallel
// tables means a unified <CommentThread> component, one server action, and
// one query path.
//
// @mentions: the action parses the raw body for @first-last tokens, looks
// up matching company users, stores their IDs in `mentions` (JSON array)
// for fast read-side highlighting, and fans out a Notification to each.
// The author is never mentioned (no self-pings).
model Comment {
  id            String    @id @default(cuid())
  companyId     String
  body          String // raw text; UI parses @mentions client-side for display
  authorId      String
  authorName    String // denormalized — survives author rename
  authorAvatar  String? // denormalized
  taskId        String?
  transactionId String?
  // JSON array of resolved userIds — `["cuid1","cuid2"]`. Stored so the
  // read path doesn't need to re-parse + DB-lookup every render. Empty
  // array (not null) when no mentions; keeps the read shape predictable.
  mentions      String    @default("[]")
  createdAt     DateTime  @default(now())
  editedAt      DateTime?
  // Tier 3 soft-delete sentinel — see User.deletedAt for semantics. Comment is
  // the EIGHTH soft-delete table (data-integrity-001, 2026-09-29). It was a hard
  // delete while CLAUDE.md's Tier 3 section and the recovery runbook both
  // counted comments as recoverable for 90 days, so a mis-clicked delete on a
  // thread hanging off a transaction destroyed the only written record of WHY a
  // founder's money moved — the one thing a bank statement cannot reconstruct.
  //
  // `deleteCommentAction`'s notification sweep stays a HARD delete and must not
  // be "made consistent" with this: a mention ping is a transient pointer, and a
  // restored comment gets a live thread back, not a re-delivered ping.
  deletedAt     DateTime?

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author      User         @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([transactionId, createdAt])
  @@index([companyId, createdAt])
  @@index([authorId])
  @@index([deletedAt])
}

// Per-user work session. `clockOutAt = null` means "currently clocked in".
//
// Auto-close pipeline:
//   • Client heartbeats lastActivityAt every 5 minutes while clocked in.
//   • At 12h since lastActivityAt, the client shows a "still working?" modal.
//   • If the user doesn't respond within 30 min, the client auto-clocks-out
//     with clockOutAt = lastActivityAt (so AFK time isn't credited).
//   • An hourly server cron sweeps any entry where lastActivityAt < now - 12.5h
//     and closes it the same way — safety net for a closed browser tab.
//
// Permissions in lib/actions/time.ts:
//   • Members can clock in/out and delete their own entries — they CANNOT
//     adjust clockInAt/clockOutAt manually.
//   • Admin and cofounder can edit any entry's times (audit-trailed via
//     editedBy + editedAt) and see the whole company's entries.
model TimeEntry {
  id             String    @id @default(cuid())
  companyId      String
  // Optional project tag — entries can stay "general work" (null). If both
  // taskId and projectId are set, the picker UI keeps them in sync (the
  // task's project wins). SetNull on delete so historical hours survive.
  projectId      String?
  projectName    String? // denormalized snapshot of the project name at clock-in
  userId         String
  userName       String // denormalized — survives user rename
  taskId         String? // optional — entry can be "untagged" general work
  taskTitle      String? // denormalized snapshot of the task name at clock-in
  note           String?
  clockInAt      DateTime  @default(now())
  clockOutAt     DateTime? // null = currently active
  // Heartbeat target — every successful client heartbeat sets this to now().
  // Drives both the in-app warning trigger AND the cron auto-close cutoff.
  lastActivityAt DateTime  @default(now())
  // Set to true when either the client idle handler OR the server cron
  // closed the entry instead of the user clicking clock-out. Lets the UI
  // show an "auto-closed" hint and helps debugging.
  autoClosed     Boolean   @default(false)
  // Manual edit audit trail. Set whenever admin/cofounder adjusts the times.
  editedBy       String?
  editedByName   String?
  editedAt       DateTime?
  createdAt      DateTime  @default(now())
  // Tier 3 soft-delete sentinel — see User.deletedAt for semantics. TimeEntry is
  // the NINTH soft-delete table (data-integrity-001, 2026-09-29), and the one
  // with the sharpest consequence: `deleteTimeEntryAction` lets a MEMBER erase
  // their own entry outright, so an accidental delete destroyed billable hours
  // that only that person could have reconstructed, and the audit trail the
  // editedBy/editedAt columns exist to keep went with it.
  //
  // READ FILTERS ARE PART OF THIS COLUMN, not a follow-up: every hours roll-up
  // (lib/queries/time.ts, lib/queries/projects.ts, lib/queries/stats.ts, the
  // workspace export) sums rows without asking, and the auto-close sweep in
  // lib/time/sweep.ts would happily re-close a tombstoned open entry. A
  // tombstone nobody filters on does not hide a row, it duplicates it.
  deletedAt      DateTime?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User     @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  editor  User?    @relation("TimeEntryEditor", fields: [editedBy], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, clockInAt])
  @@index([companyId, clockInAt])
  @@index([taskId])
  @@index([projectId, clockInAt])
  // Lets the cron find open entries to auto-close without scanning every row.
  @@index([clockOutAt, lastActivityAt])
  @@index([deletedAt])
}

// A project is the unit founders plan against — owns tasks, budgets, time
// entries, and optionally transactions. One company can own any number of
// projects.
//
// Supervisor model:
//   - Each project has exactly one supervisorId (User).
//   - The supervisor gets ELEVATED permissions inside this project:
//     manage its tasks and budgets, see its finance figures, even when
//     their global role is "member". See lib/auth/project-permissions.ts.
//   - Supervisor can be reassigned (admin/cofounder only) via
//     changeSupervisorAction; an Activity row + a Notification land on
//     the new supervisor.
//
// Visibility for members:
//   - A member sees a project iff they're the supervisor OR they have at
//     least one assigned task in it. Derived in listProjectsForUser().
//   - There's no separate ProjectMember table — task assignments + the
//     supervisor FK encode "who's on this project."
//
// Migration & backfill:
//   - The add_projects migration creates one "General" project per company
//     and back-fills every existing Task + Budget row's projectId there.
//   - After that backfill, Task.projectId and Budget.projectId are NOT NULL.
model Project {
  id            String    @id @default(cuid())
  companyId     String
  name          String
  description   String? // one-line summary shown on cards
  supervisorId  String
  // Lifecycle: active | on_hold | completed | archived. Status drives the
  // default filter on /projects (archived hidden by default) and shifts
  // the card's visual tone.
  status        String    @default("active")
  // Color tag drawn from a fixed palette (emerald | forest | mint | slate
  // | warning). Stored as a string slug, NOT a hex — keeps swatches in lock
  // step with the design tokens defined in app/globals.css. The retired
  // primary/cyan/pink/info slugs were remapped by the rebrand migration
  // 20260923000000_rebrand_project_colors; lib/schemas/project.ts is the
  // authoritative list.
  color         String    @default("emerald")
  // Optional planned end. When set + status="active" + past today, the
  // project card renders an overdue chip.
  targetEndDate DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  // OPTIMISTIC-CONCURRENCY TOKEN for project edits (projects-010, 2026-09-29).
  // Two people editing the same project's NAME still silently destroyed each
  // other's work: the status paths were narrowed to write one column, but a name
  // or description edit is a whole-form submit, so the slower save wins and the
  // faster one vanishes with no error and no trace. Detecting that needs a value
  // that changes on EVERY write, which is what @updatedAt is; the edit action
  // compares the value the form was rendered from and reports a conflict instead
  // of overwriting. That comparison is the point of the column — a project row
  // that merely carries a fresh timestamp has changed nothing.
  //
  // BOTH ATTRIBUTES, deliberately. `@updatedAt` is maintained by the Prisma
  // client, so a row written by anything else — the migration's own back-fill, a
  // raw INSERT, an ops fix in the Supabase console — would have nothing to put
  // here. `@default(now())` puts the DEFAULT in Postgres as well, and that is
  // what makes this column safe to deploy: migrations run at BUILD time
  // (CLAUDE.md), so for the minutes between `migrate deploy` and the new
  // deployment going live, the PREVIOUS build's Prisma client is still creating
  // projects and does not know this column exists. Without a database-side
  // default those INSERTs fail the NOT NULL and project creation 500s for every
  // customer mid-deploy. Do not "tidy" the @default away.
  updatedAt     DateTime  @default(now()) @updatedAt
  // Tier 3 soft-delete sentinel — see User.deletedAt for semantics.
  deletedAt     DateTime?

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supervisor User    @relation("ProjectSupervisor", fields: [supervisorId], references: [id])
  creator    User    @relation("ProjectCreator", fields: [createdBy], references: [id])

  tasks          Task[]
  budgets        Budget[]
  timeEntries    TimeEntry[]
  transactions   Transaction[]
  activities     Activity[]
  notifications  Notification[]
  recurringRules RecurringRule[]

  @@index([companyId, status])
  @@index([supervisorId])
  @@index([deletedAt])
}

// ─── Chat ────────────────────────────────────────────────────────────────
//
// Channels + messages for the in-app chat surface. Same conventions as the
// rest of the schema: unions live in zod (lib/schemas/chat.ts), author fields
// are denormalized exactly like Comment, and visibility is decided by the pure
// predicates in lib/auth/channel-permissions.ts — never inline in an action.

model Channel {
  id            String    @id @default(cuid())
  companyId     String
  // "public" | "private" | "dm". String, not a Prisma enum — CHANNEL_KINDS in
  // lib/schemas/chat.ts owns the union at the app boundary. Drives visibility:
  // canSeeChannel() in lib/auth/channel-permissions.ts.
  kind          String
  // URL segment (/chat/<slug>). For a DM this holds the dmKey, so a DM is
  // addressable by the same route shape as a named channel and needs no
  // second lookup table.
  slug          String
  name          String
  topic         String?
  // Sorted "userIdA:userIdB", produced by dmKeyFor() in
  // lib/auth/channel-permissions.ts. NULL for non-DMs. Sorting is what stops
  // the same pair forking into two parallel conversations; the
  // @@unique([companyId, dmKey]) below is the hard guarantee.
  dmKey         String?
  createdBy     String
  createdAt     DateTime  @default(now())
  // Archive is a soft close, NOT a delete: history stays readable, posting
  // stops. canPostInChannel() rejects on this.
  archivedAt    DateTime?
  // Denormalized timestamp of the newest message, so the channel rail can
  // ORDER BY recency without an aggregate over Message on every page load.
  // Written by the send path in lib/actions/chat.ts.
  lastMessageAt DateTime?

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Cascade, not Restrict: the ONLY path that hard-deletes a User is
  // whole-workspace erasure (the purge cron has no individual-user stage by
  // design), where the channel is going away regardless. Restrict here would
  // jam that transaction on a table the cron doesn't know about.
  creator  User            @relation("ChannelCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members  ChannelMember[]
  messages Message[]

  // Slugs are per-workspace, not global — two companies may both have #general.
  @@unique([companyId, slug])
  // One DM per ordered pair per workspace. The anti-fork guarantee.
  @@unique([companyId, dmKey])
  @@index([companyId, kind])
  @@index([companyId, lastMessageAt])
}

model ChannelMember {
  id                String    @id @default(cuid())
  channelId         String
  userId            String
  // "owner" | "member" — CHANNEL_ROLES in lib/schemas/chat.ts. The channel
  // owner gets rename/archive rights without being a company admin; see
  // canManageChannel() in lib/auth/channel-permissions.ts.
  role              String    @default("member")
  joinedAt          DateTime  @default(now())
  // Read watermark. Unread = messages newer than this that I did not author.
  // Defaults to now() (and the migration backfills now()) so joining a channel
  // never greets you with a fabricated unread badge for history you never saw.
  lastReadAt        DateTime  @default(now())
  // Last message the user actually read. Deliberately NOT a foreign key: it is
  // a watermark, and an FK would either jam a message purge or null itself out
  // from under the badge maths. lastReadAt is the authoritative comparison.
  lastReadMessageId String?
  // Muted = still a member, still sees the channel, just no notification
  // fan-out. NULL = unmuted.
  mutedAt           DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One membership row per person per channel; join/leave toggles the row.
  @@unique([channelId, userId])
  // Backs "every channel I'm in" — the channel rail's primary query.
  @@index([userId])
}

model Message {
  id           String                   @id @default(cuid())
  // Denormalized company scope. Every read path is already company-scoped, and
  // carrying it here means the workspace-wide sweeps (purge, export) don't have
  // to join through Channel.
  companyId    String
  channelId    String
  authorId     String
  authorName   String // denormalized — survives a rename, exactly like Comment
  authorAvatar String? // denormalized
  // "text" | "card" — MESSAGE_KINDS in lib/schemas/chat.ts.
  kind         String                   @default("text")
  body         String
  // JSON, versioned — the structured payload for kind "card" (e.g. a Runway
  // snapshot). NULL for plain text. String, not Json, so the column stays
  // portable and the version tag inside it owns migration of the shape.
  payload      String?
  // Thread root. NULL = the message IS a root. SetNull on delete so purging a
  // root promotes its replies to roots instead of cascading them away.
  parentId     String?
  // Denormalized count of direct replies, so a root row renders "5 replies"
  // without an aggregate per row. Maintained by the send/delete paths in
  // lib/actions/chat.ts.
  replyCount   Int                      @default(0)
  // JSON array of resolved userIds — `["cuid1","cuid2"]`. Same shape and same
  // reasoning as Comment.mentions.
  mentions     String                   @default("[]")
  createdAt    DateTime                 @default(now())
  editedAt     DateTime?
  // Tombstone — see User.deletedAt for semantics. Message is the SEVENTH
  // soft-delete table. A deleted message must not silently rewrite history:
  // the row survives so replies keep their parent and the thread still reads
  // in order; the UI renders "message deleted" in its place.
  deletedAt    DateTime?
  // Full-text search vector over `body`, added by the Phase H cross-content
  // search rollout (migration 20260925120000_add_message_search). Postgres
  // owns it end to end — the real column is
  //   tsvector GENERATED ALWAYS AS (to_tsvector('english', coalesce("body", ''))) STORED
  // so it is recomputed on every INSERT/UPDATE of `body` and physically cannot
  // drift out of step with the text it indexes. No application code writes it.
  //
  // `Unsupported` means the Prisma client can neither select nor write this
  // field, and that is the intent, not a limitation we are working around:
  // search reads it through `$queryRaw` (lib/queries/), never through the
  // client. It is declared here for one reason only — without the declaration
  // `prisma migrate dev` sees a column the schema does not know about, calls
  // it drift, and cheerfully generates a migration that DROPs the column and
  // its index. Declaring it keeps the diff quiet.
  //
  // WARNING to the next person running `migrate dev`: the diff can see the
  // column's NAME and TYPE but NOT the `GENERATED ALWAYS ... STORED`
  // expression behind it, because Prisma has no schema syntax for a generated
  // column. So a future `migrate dev` may offer to "fix" this column by
  // recreating it as a plain, empty tsvector. The answer is NO — accepting it
  // silently turns every chat search result into zero rows, with no error
  // anywhere. Delete that step out of any generated migration.
  //
  // Reminder for query authors: the vector is computed from `body` alone and
  // knows nothing about tombstones, so a soft-deleted message still matches.
  // Every search query MUST add `"deletedAt" IS NULL` itself.
  searchVector Unsupported("tsvector")?

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel   Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User              @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent    Message?          @relation("MessageThread", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replies   Message[]         @relation("MessageThread")
  reactions MessageReaction[]
  // The GIN index over searchVector — "Message_searchVector_idx" — is NOT
  // listed here and cannot be: Prisma has no syntax for a GIN index, nor for
  // any index on an Unsupported column. It lives in SQL only, created by
  // 20260925120000_add_message_search. Its absence from this block is not an
  // oversight, and `prisma migrate` will not propose to drop it (it ignores
  // indexes on columns it cannot model). Anything that changes it is a
  // hand-written migration.

  // The channel timeline.
  @@index([channelId, createdAt])
  // One thread's replies, and the "roots only" timeline (parentId IS NULL).
  @@index([channelId, parentId, createdAt])
  // Workspace-wide sweeps: search, export, purge.
  @@index([companyId, createdAt])
  @@index([authorId])
  @@index([deletedAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  // One of REACTION_EMOJI in lib/schemas/chat.ts — a fixed allow-list, not a
  // free-text column, so the rail renders a known set of chips.
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One of each emoji per person; toggling off is a delete, not a counter.
  @@unique([messageId, userId, emoji])
  @@index([messageId])
}
